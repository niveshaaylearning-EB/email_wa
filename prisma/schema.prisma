// Niveshaay Communication Center — PostgreSQL schema
//
// Source-of-truth boundaries:
//   * Zoho CRM owns client identity + contact details (clients.* crm fields are overwritten by sync).
//   * PostgreSQL owns categories, memberships, template mappings, campaigns, consents,
//     suppressions and audit records. CRM sync NEVER writes to client_categories.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum RoleKey {
  ADMIN
  CAMPAIGN_CREATOR
  APPROVER
  VIEWER
  COMPLIANCE_OFFICER
}

enum Channel {
  EMAIL
  WHATSAPP
}

enum ChannelMode {
  EMAIL
  WHATSAPP
  BOTH
}

enum Provider {
  ZOHO_CRM
  ZOHO_MA
  DOUBLETICK
}

enum ProviderMode {
  MOCK // simulated adapter, simulated events, always labelled
  DRY_RUN // real config, renders + validates, never calls send endpoints
  LIVE // real sends — requires env ALLOW_LIVE_SEND=true + admin enablement + per-campaign confirmation
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  ERROR
  DISCONNECTED
}

enum MembershipSource {
  MANUAL
  BULK
  CSV
  RULE
}

enum MembershipAction {
  ADDED
  REMOVED
}

enum TemplateApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum CampaignPurpose {
  RESEARCH_UPDATE
  PORTFOLIO_ADVISORY
  SERVICE_NOTICE
  EVENT_INVITATION
  REGULATORY_DISCLOSURE
  MARKETING
  OTHER
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  APPROVED
  SCHEDULED
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum OverlapStrategy {
  PRIORITY // highest-priority selected category wins
  PER_CATEGORY // one message per matched category (only when explicitly permitted)
  EXCLUDE_CONFLICTS // drop recipients whose matched categories map to different templates
  MANUAL_REVIEW // default: conflicting recipients held until a reviewer decides
}

enum RecipientStatus {
  ELIGIBLE
  EXCLUDED
  NEEDS_REVIEW
}

enum ExclusionReason {
  MISSING_EMAIL
  MISSING_PHONE
  INVALID_EMAIL
  INVALID_PHONE
  UNSUBSCRIBED
  NO_CONSENT
  SUPPRESSED
  CRM_OPT_OUT
  CONFLICT_EXCLUDED
  CONFLICT_UNRESOLVED
  CLIENT_INACTIVE
  DUPLICATE_IDENTITY
  MISSING_TEMPLATE_DATA
}

enum AssignmentStatus {
  PLANNED
  NEEDS_REVIEW
  EXCLUDED
}

enum DeliveryStatus {
  PENDING // created, not yet handed to provider
  QUEUED // in job queue
  SUBMITTED // request sent, awaiting provider response
  ACCEPTED // provider API accepted (NOT delivered)
  SENT // provider reports sent to network
  DELIVERED
  READ
  FAILED
  BOUNCED
  CANCELLED
  DRY_RUN // rendered + validated only, no provider call
}

enum DeliveryEventSource {
  SYSTEM
  API_RESPONSE
  WEBHOOK
  REPORT_RECONCILIATION
  SIMULATION
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum ConsentSource {
  CRM
  MANUAL
  CSV
  PROVIDER_UNSUBSCRIBE
  CLIENT_REQUEST
}

enum SuppressionReason {
  UNSUBSCRIBED
  HARD_BOUNCE
  COMPLAINT
  MANUAL
  DND
  INVALID_CONTACT
  LEGAL_HOLD
}

enum IdentifierType {
  EMAIL
  PHONE
}

enum SyncType {
  INITIAL
  INCREMENTAL
  MANUAL
  DELETED_RECORDS
  RULE_EVALUATION
  PROVIDER_REPORT
  AUDIENCE_SYNC
}

enum SyncStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  IGNORED
  REJECTED
  FAILED
}

// ───────────────────────────── Identity & access ─────────────────────────────

model Role {
  id          String   @id @default(cuid())
  key         RoleKey  @unique
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  roleId       String    @map("role_id")
  role         Role      @relation(fields: [roleId], references: [id])
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  failedLogins Int       @default(0) @map("failed_logins")
  lockedUntil  DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sessions           Session[]
  auditLogs          AuditLog[]
  createdCategories  Category[]        @relation("CategoryCreatedBy")
  createdCampaigns   Campaign[]        @relation("CampaignCreatedBy")
  updatedCampaigns   Campaign[]        @relation("CampaignUpdatedBy")
  submittedCampaigns Campaign[]        @relation("CampaignSubmittedBy")
  approvedCampaigns  Campaign[]        @relation("CampaignApprovedBy")
  rejectedCampaigns  Campaign[]        @relation("CampaignRejectedBy")
  cancelledCampaigns Campaign[]        @relation("CampaignCancelledBy")
  membershipEvents   MembershipEvent[]
  templateVersions   TemplateVersion[]

  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @map("expires_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────────── Clients (CRM mirror) ─────────────────────────────

model Client {
  id               String    @id @default(cuid())
  zohoCrmId        String    @unique @map("zoho_crm_id")
  crmModule        String    @default("Contacts") @map("crm_module")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  fullName         String    @map("full_name")
  email            String?
  emailNormalized  String?   @map("email_normalized")
  secondaryEmail   String?   @map("secondary_email")
  phoneRaw         String?   @map("phone_raw")
  phoneE164        String?   @map("phone_e164")
  phoneCountry     String?   @map("phone_country") // ISO-3166 alpha-2
  phoneCountryCode String?   @map("phone_country_code") // e.g. "91"
  phoneValid       Boolean   @default(false) @map("phone_valid")
  crmStatus        String?   @map("crm_status")
  crmOwner         String?   @map("crm_owner")
  city             String?
  crmEmailOptOut   Boolean   @default(false) @map("crm_email_opt_out")
  crmFields        Json      @default("{}") @map("crm_fields") // whitelisted extra CRM fields for rules
  crmModifiedAt    DateTime? @map("crm_modified_at")
  lastSyncedAt     DateTime? @map("last_synced_at")
  deletedInCrmAt   DateTime? @map("deleted_in_crm_at")
  duplicateOfId    String?   @map("duplicate_of_id")
  duplicateOf      Client?   @relation("ClientDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Client[]  @relation("ClientDuplicates")
  isMock           Boolean   @default(false) @map("is_mock")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  memberships      ClientCategory[]
  membershipEvents MembershipEvent[]
  consents         Consent[]
  suppressions     SuppressionEntry[]
  recipients       CampaignRecipient[]
  deliveries       MessageDelivery[]

  @@index([emailNormalized])
  @@index([phoneE164])
  @@index([fullName])
  @@index([crmModifiedAt])
  @@index([duplicateOfId])
  @@map("clients")
}

// ───────────────────────────── Categories ─────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  color       String    @default("#1F4E79")
  priority    Int       @default(100) // lower = higher precedence when PRIORITY overlap strategy is used
  createdById String?   @map("created_by_id")
  createdBy   User?     @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  memberships      ClientCategory[]
  membershipEvents MembershipEvent[]
  rules            CategoryRule[]
  templates        CategoryTemplate[]
  campaigns        CampaignCategory[]
  assignments      CampaignMessageAssignment[]

  @@index([archivedAt])
  @@map("categories")
}

/// Many-to-many membership. Soft-removed rows keep history; re-adding clears removed_at.
model ClientCategory {
  id          String           @id @default(cuid())
  clientId    String           @map("client_id")
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  categoryId  String           @map("category_id")
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  source      MembershipSource
  ruleId      String?          @map("rule_id")
  rule        CategoryRule?    @relation(fields: [ruleId], references: [id])
  addedById   String?          @map("added_by_id")
  addedAt     DateTime         @default(now()) @map("added_at")
  removedAt   DateTime?        @map("removed_at")
  removedById String?          @map("removed_by_id")

  @@unique([clientId, categoryId])
  @@index([categoryId, removedAt])
  @@index([clientId, removedAt])
  @@map("client_categories")
}

model MembershipEvent {
  id         String           @id @default(cuid())
  clientId   String           @map("client_id")
  client     Client           @relation(fields: [clientId], references: [id])
  categoryId String           @map("category_id")
  category   Category         @relation(fields: [categoryId], references: [id])
  action     MembershipAction
  source     MembershipSource
  actorId    String?          @map("actor_id")
  actor      User?            @relation(fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([categoryId, createdAt])
  @@index([clientId, createdAt])
  @@map("membership_events")
}

/// Dashboard-defined dynamic rule evaluated against mirrored CRM data.
/// Rule evaluation only adds/removes memberships whose source = RULE and rule_id = this rule.
model CategoryRule {
  id              String    @id @default(cuid())
  categoryId      String    @map("category_id")
  category        Category  @relation(fields: [categoryId], references: [id])
  name            String
  definition      Json // validated by RuleDefinitionSchema (src/lib/contracts/rules.ts)
  isActive        Boolean   @default(true) @map("is_active")
  autoRemove      Boolean   @default(false) @map("auto_remove")
  lastEvaluatedAt DateTime? @map("last_evaluated_at")
  lastMatchCount  Int?      @map("last_match_count")
  createdById     String?   @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  memberships ClientCategory[]

  @@index([categoryId])
  @@map("category_rules")
}

// ───────────────────────────── Templates ─────────────────────────────

/// Local registry of provider templates. Content is linked (not authored) where the
/// provider does not support template creation via API.
model Template {
  id                 String                 @id @default(cuid())
  channel            Channel
  name               String
  description        String?
  provider           Provider
  providerTemplateId String?                @map("provider_template_id") // DoubleTick template name / Zoho MA campaign key
  language           String? // WhatsApp language code e.g. "en"
  subject            String? // email subject (preview/render)
  senderName         String?                @map("sender_name")
  body               String // preview body with {{variable}} tokens
  header             Json? // WA header {type, text|mediaUrl, filename}
  buttons            Json? // WA buttons [{type, index, variable?}]
  variables          Json                   @default("[]") // [{key,label,source,required,sample}]
  approvalStatus     TemplateApprovalStatus @default(DRAFT) @map("approval_status")
  currentVersion     Int                    @default(1) @map("current_version")
  archivedAt         DateTime?              @map("archived_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  versions    TemplateVersion[]
  categories  CategoryTemplate[]
  assignments CampaignMessageAssignment[]

  @@unique([channel, name])
  @@index([channel, approvalStatus])
  @@map("templates")
}

model TemplateVersion {
  id          String   @id @default(cuid())
  templateId  String   @map("template_id")
  template    Template @relation(fields: [templateId], references: [id])
  version     Int
  snapshot    Json // full template content at this version
  contentHash String   @map("content_hash")
  changeNote  String?  @map("change_note")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  assignments CampaignMessageAssignment[]

  @@unique([templateId, version])
  @@map("template_versions")
}

/// Authorises a template for use with a category.
model CategoryTemplate {
  id          String    @id @default(cuid())
  categoryId  String    @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id])
  templateId  String    @map("template_id")
  template    Template  @relation(fields: [templateId], references: [id])
  channel     Channel
  isDefault   Boolean   @default(false) @map("is_default")
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  removedAt   DateTime? @map("removed_at")

  @@unique([categoryId, templateId])
  @@index([templateId])
  @@map("category_templates")
}

// ───────────────────────────── Campaigns ─────────────────────────────

model Campaign {
  id                 String          @id @default(cuid())
  name               String
  description        String?
  purpose            CampaignPurpose
  channelMode        ChannelMode     @map("channel_mode")
  status             CampaignStatus  @default(DRAFT)
  overlapStrategy    OverlapStrategy @default(MANUAL_REVIEW) @map("overlap_strategy")
  scheduledAt        DateTime?       @map("scheduled_at")
  timezone           String          @default("Asia/Kolkata")
  rateLimitPerMinute Int             @default(60) @map("rate_limit_per_minute")
  isLive             Boolean         @default(false) @map("is_live") // false = dry-run / mock execution
  version            Int             @default(1) // optimistic locking

  createdById     String    @map("created_by_id")
  createdBy       User      @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  updatedById     String?   @map("updated_by_id")
  updatedBy       User?     @relation("CampaignUpdatedBy", fields: [updatedById], references: [id])
  submittedById   String?   @map("submitted_by_id")
  submittedBy     User?     @relation("CampaignSubmittedBy", fields: [submittedById], references: [id])
  submittedAt     DateTime? @map("submitted_at")
  approvedById    String?   @map("approved_by_id")
  approvedBy      User?     @relation("CampaignApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime? @map("approved_at")
  approvalNote    String?   @map("approval_note")
  rejectedById    String?   @map("rejected_by_id")
  rejectedBy      User?     @relation("CampaignRejectedBy", fields: [rejectedById], references: [id])
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")
  liveConfirmedAt DateTime? @map("live_confirmed_at")
  queuedAt        DateTime? @map("queued_at")
  startedAt       DateTime? @map("started_at")
  pausedAt        DateTime? @map("paused_at")
  completedAt     DateTime? @map("completed_at")
  cancelledAt     DateTime? @map("cancelled_at")
  cancelledById   String?   @map("cancelled_by_id")
  cancelledBy     User?     @relation("CampaignCancelledBy", fields: [cancelledById], references: [id])
  failureReason   String?   @map("failure_reason")
  providerRefs    Json      @default("{}") @map("provider_refs") // e.g. { zohoMa: { groups: [...] } }
  reviewDecisions Json      @default("{}") @map("review_decisions") // { [clientId]: { EMAIL?: {categoryId}|{exclude:true}, WHATSAPP?: ... } }
  testSendCount   Int       @default(0) @map("test_send_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  categories  CampaignCategory[]
  recipients  CampaignRecipient[]
  assignments CampaignMessageAssignment[]
  deliveries  MessageDelivery[]
  snapshot    CampaignSnapshot?

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@map("campaigns")
}

model CampaignCategory {
  id                    String   @id @default(cuid())
  campaignId            String   @map("campaign_id")
  campaign              Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  categoryId            String   @map("category_id")
  category              Category @relation(fields: [categoryId], references: [id])
  priority              Int      @default(1) // explicit precedence within this campaign (1 = highest)
  emailTemplateId       String?  @map("email_template_id")
  whatsappTemplateId    String?  @map("whatsapp_template_id")
  memberCountAtSnapshot Int?     @map("member_count_at_snapshot")

  @@unique([campaignId, categoryId])
  @@unique([campaignId, priority])
  @@map("campaign_categories")
}

/// Frozen at approval. Protected from UPDATE/DELETE by a database trigger.
model CampaignSnapshot {
  id          String   @id @default(cuid())
  campaignId  String   @unique @map("campaign_id")
  campaign    Campaign @relation(fields: [campaignId], references: [id])
  frozenAt    DateTime @default(now()) @map("frozen_at")
  frozenById  String   @map("frozen_by_id")
  summary     Json // counts, exclusions, overlap stats
  categories  Json // membership counts + template versions at approval
  contentHash String   @map("content_hash")

  @@map("campaign_snapshots")
}

model CampaignRecipient {
  id                 String            @id @default(cuid())
  campaignId         String            @map("campaign_id")
  campaign           Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId           String            @map("client_id")
  client             Client            @relation(fields: [clientId], references: [id])
  status             RecipientStatus
  exclusionReasons   ExclusionReason[] @map("exclusion_reasons")
  matchedCategoryIds String[]          @map("matched_category_ids")
  contactSnapshot    Json              @map("contact_snapshot") // name/email/phone frozen at approval
  consentDecision    Json              @map("consent_decision") // per-channel decision + evidence ids
  createdAt          DateTime          @default(now()) @map("created_at")

  assignments CampaignMessageAssignment[]

  @@unique([campaignId, clientId])
  @@index([campaignId, status])
  @@map("campaign_recipients")
}

/// Final recipient → (channel, category, template) mapping. Unique per campaign/recipient/channel/template.
model CampaignMessageAssignment {
  id                String            @id @default(cuid())
  campaignId        String            @map("campaign_id")
  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientId       String            @map("recipient_id")
  recipient         CampaignRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  channel           Channel
  categoryId        String            @map("category_id")
  category          Category          @relation(fields: [categoryId], references: [id])
  templateId        String            @map("template_id")
  template          Template          @relation(fields: [templateId], references: [id])
  templateVersionId String?           @map("template_version_id")
  templateVersion   TemplateVersion?  @relation(fields: [templateVersionId], references: [id])
  status            AssignmentStatus
  rendered          Json? // rendered subject/body/placeholders at freeze
  idempotencyKey    String            @unique @map("idempotency_key")
  createdAt         DateTime          @default(now()) @map("created_at")

  delivery MessageDelivery?

  @@unique([campaignId, recipientId, channel, templateId])
  @@index([campaignId, status])
  @@map("campaign_message_assignments")
}

model MessageDelivery {
  id                String                    @id @default(cuid())
  assignmentId      String                    @unique @map("assignment_id")
  assignment        CampaignMessageAssignment @relation(fields: [assignmentId], references: [id])
  campaignId        String                    @map("campaign_id")
  campaign          Campaign                  @relation(fields: [campaignId], references: [id])
  clientId          String                    @map("client_id")
  client            Client                    @relation(fields: [clientId], references: [id])
  channel           Channel
  provider          Provider
  status            DeliveryStatus            @default(PENDING)
  providerMessageId String?                   @unique @map("provider_message_id")
  attemptCount      Int                       @default(0) @map("attempt_count")
  nextAttemptAt     DateTime?                 @map("next_attempt_at")
  lastAttemptAt     DateTime?                 @map("last_attempt_at")
  submittedAt       DateTime?                 @map("submitted_at")
  acceptedAt        DateTime?                 @map("accepted_at")
  sentAt            DateTime?                 @map("sent_at")
  deliveredAt       DateTime?                 @map("delivered_at")
  readAt            DateTime?                 @map("read_at")
  openedAt          DateTime?                 @map("opened_at")
  clickedAt         DateTime?                 @map("clicked_at")
  failedAt          DateTime?                 @map("failed_at")
  failureCode       String?                   @map("failure_code")
  failureReason     String?                   @map("failure_reason")
  isSimulated       Boolean                   @default(false) @map("is_simulated")
  isDryRun          Boolean                   @default(false) @map("is_dry_run")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  events DeliveryEvent[]

  @@index([campaignId, status])
  @@index([clientId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("message_deliveries")
}

model DeliveryEvent {
  id         String              @id @default(cuid())
  deliveryId String              @map("delivery_id")
  delivery   MessageDelivery     @relation(fields: [deliveryId], references: [id])
  source     DeliveryEventSource
  fromStatus DeliveryStatus?     @map("from_status")
  toStatus   DeliveryStatus      @map("to_status")
  detail     Json? // masked provider response / error
  occurredAt DateTime            @map("occurred_at")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([deliveryId, occurredAt])
  @@map("delivery_events")
}

// ───────────────────────────── Consent & suppression ─────────────────────────────

/// Append-only. The latest effective record per (client, channel) is the current decision.
model Consent {
  id           String        @id @default(cuid())
  clientId     String        @map("client_id")
  client       Client        @relation(fields: [clientId], references: [id])
  channel      Channel
  status       ConsentStatus
  source       ConsentSource
  purpose      String        @default("communications")
  evidence     String?
  recordedById String?       @map("recorded_by_id")
  effectiveAt  DateTime      @default(now()) @map("effective_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([clientId, channel, effectiveAt])
  @@map("consents")
}

model SuppressionEntry {
  id              String            @id @default(cuid())
  channel         Channel? // null = all channels
  identifierType  IdentifierType    @map("identifier_type")
  identifierValue String            @map("identifier_value") // normalized email / E.164
  clientId        String?           @map("client_id")
  client          Client?           @relation(fields: [clientId], references: [id])
  reason          SuppressionReason
  source          String
  note            String?
  createdById     String?           @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  liftedAt        DateTime?         @map("lifted_at")
  liftedById      String?           @map("lifted_by_id")

  @@index([identifierType, identifierValue, liftedAt])
  @@index([clientId])
  @@map("suppression_entries")
}

model InternalTestRecipient {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phoneE164 String?  @map("phone_e164")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("internal_test_recipients")
}

// ───────────────────────────── Integrations & operations ─────────────────────────────

model IntegrationSetting {
  id               String            @id @default(cuid())
  provider         Provider          @unique
  mode             ProviderMode      @default(MOCK)
  status           IntegrationStatus @default(NOT_CONFIGURED)
  config           Json              @default("{}") // non-secret config (region, sender, etc.)
  secretsEncrypted String?           @map("secrets_encrypted") // AES-256-GCM envelope
  secretsHint      Json              @default("{}") @map("secrets_hint") // masked hints only
