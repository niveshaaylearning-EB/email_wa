  connectionId   String   @map("connection_id")
  mid            String
  journeyId      String   @map("journey_id")
  key            String?
  name           String?
  version        Int
  status         String?
  definitionType String?  @map("definition_type")
  createdDate    String?  @map("created_date")
  modifiedDate   String?  @map("modified_date")
  entrySources   Json     @default("[]") @map("entry_sources")
  activities     Json     @default("[]")
  gaps           Json     @default("[]") // fields / history not available from the API
  raw            Json     @default("{}")
  datasetId      String   @map("dataset_id")
  isSimulated    Boolean  @default(false) @map("is_simulated")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  @@unique([connectionId, mid, journeyId, version])
  @@map("salesforce_journeys")
}

model SalesforceAutomation {
  id           String   @id @default(cuid())
  connectionId String   @map("connection_id")
  mid          String
  kind         String // AUTOMATION | QUERY_DEFINITION
  objectId     String   @map("object_id")
  customerKey  String?  @map("customer_key")
  name         String?
  description  String?
  status       String?
  schedule     Json     @default("{}")
  activities   Json     @default("[]")
  definition   String? // e.g. QueryText
  gaps         Json     @default("[]")
  raw          Json     @default("{}")
  datasetId    String   @map("dataset_id")
  isSimulated  Boolean  @default(false) @map("is_simulated")
  firstSeenAt  DateTime @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")

  @@unique([connectionId, mid, kind, objectId])
  @@map("salesforce_automations")
}

model SalesforceReconciliationJob {
  id                String        @id @default(cuid())
  code              String        @unique // REC-yyyyMMdd-xxxxxx
  name              String
  connectionId      String?       @map("connection_id")
  mid               String
  jobIds            String[]      @map("job_ids")
  sendDateFrom      DateTime?     @map("send_date_from")
  sendDateTo        DateTime?     @map("send_date_to")
  audienceDatasetId String        @map("audience_dataset_id")
  audienceSource    String        @map("audience_source") // DE_BACKUP | UPLOAD
  audienceLabel     String        @map("audience_label") // CURRENT_STATE | HISTORICAL_EVIDENCED
  audienceEvidence  Json          @default("{}") @map("audience_evidence")
  identityMapping   Json          @map("identity_mapping")
  status            SfReconStatus @default(QUEUED)
  summary           Json          @default("{}")
  limitations       Json          @default("[]")
  inputsSha256      String?       @map("inputs_sha256")
  errorMessage      String?       @map("error_message")
  isSimulated       Boolean       @default(false) @map("is_simulated")
  createdById       String?       @map("created_by_id")
  createdByEmail    String?       @map("created_by_email")
  createdAt         DateTime      @default(now()) @map("created_at")
  startedAt         DateTime?     @map("started_at")
  finishedAt        DateTime?     @map("finished_at")

  results SalesforceReconciliationResult[]

  @@index([mid, createdAt])
  @@map("salesforce_reconciliation_jobs")
}

model SalesforceReconciliationResult {
  id               BigInt                      @id @default(autoincrement())
  reconciliationId String                      @map("reconciliation_id")
  reconciliation   SalesforceReconciliationJob @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  identity         String? // normalised identity used for matching
  rawIdentity      String?                     @map("raw_identity")
  classification   SfReconClass
  flags            String[]                    @default([]) // BOUNCE_EVENT, UNSUB_EVENT, NOTSENT_EVENT, …
  audienceRefs     Json                        @default("[]") @map("audience_refs") // [{page,row}]
  sentEventCount   Int                         @default(0) @map("sent_event_count")
  firstSentAt      DateTime?                   @map("first_sent_at")
  evidence         Json                        @default("{}")

  @@index([reconciliationId, classification])
  @@index([reconciliationId, identity])
  @@map("salesforce_reconciliation_results")
}

model SalesforceEvidencePackage {
  id             String   @id @default(cuid())
  code           String   @unique // EVP-yyyyMMdd-xxxxxx
  kind           String // CAMPAIGN | RECONCILIATION | SUBSCRIBER
  title          String
  params         Json
  files          Json     @default("[]") // [{name, sha256, bytes, storageKey, contentType}]
  manifestSha256 String?  @map("manifest_sha256")
  status         String   @default("READY")
  isSimulated    Boolean  @default(false) @map("is_simulated")
  createdById    String?  @map("created_by_id")
  createdByEmail String?  @map("created_by_email")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@map("salesforce_evidence_packages")
}

model SalesforceExtractionError {
  id           String    @id @default(cuid())
  connectionId String?   @map("connection_id")
  backupJobId  String?   @map("backup_job_id")
  datasetId    String?   @map("dataset_id")
  mid          String?
  objectType   String?   @map("object_type")
  stage        String // auth | retrieve | rest | store | verify
  httpStatus   Int?      @map("http_status")
  code         String?
  message      String
  retryable    Boolean   @default(false)
  attempt      Int       @default(1)
  pageNo       Int?      @map("page_no")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([backupJobId])
  @@index([datasetId])
  @@index([createdAt])
  @@map("salesforce_extraction_errors")
}

model SalesforceExtractionLog {
  id          BigInt   @id @default(autoincrement())
  backupJobId String?  @map("backup_job_id")
  datasetId   String?  @map("dataset_id")
  level       String // info | warn | error
  message     String
  data        Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([backupJobId, createdAt])
  @@index([datasetId, createdAt])
  @@map("salesforce_extraction_logs")
}

model SalesforceArchiveAuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorEmail String   @map("actor_email")
  action     String // e.g. archive.export.csv, archive.evidence.generated
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("salesforce_archive_audit_logs")
}
