// ═════════════════════ SALESFORCE MARKETING CLOUD ARCHIVE ═════════════════════
//
// Read-only backup of Salesforce Marketing Cloud Engagement (SFMC) for SEBI audit evidence.
// Rules enforced in code and, where marked, by database triggers
// (migration *_salesforce_archive_guards):
//   * Nothing here is ever written back to Salesforce. The SFMC client only issues SOAP
//     Retrieve and allow-listed REST GET/query calls.
//   * Extracted rows/events are stored per dataset (one extraction of one object) keyed by
//     (dataset, page, row) and never collapsed. A sealed dataset's rows cannot change.
//   * Manifests and the archive audit log are append-only.
//   * Source values are preserved as the strings SFMC returned (no numeric coercion).

enum SfConnectionKind {
  LIVE // real SFMC tenant via Installed Package (server-to-server)
  SIMULATED // in-process fake SFMC for development and tests; refused in production; every record flagged
}

enum SfConnectionStatus {
  NOT_CONFIGURED
  CONFIGURED
  CONNECTED
  ERROR
}

enum SfBackupMode {
  FULL
  INCREMENTAL
}

enum SfBackupJobStatus {
  QUEUED
  RUNNING
  CANCELLING
  CANCELLED
  COMPLETED // all requested datasets extracted (see verificationStatus for completeness)
  COMPLETED_WITH_GAPS // some datasets failed, inaccessible or not retrievable
  FAILED
}

enum SfDatasetKind {
  BUSINESS_UNITS
  DATA_FOLDERS
  DE_INVENTORY // DataExtension + DataExtensionField metadata
  DE_ROWS // DataExtensionObject rows of one DE
  SUBSCRIBERS
  LISTS
  EMAIL_JOBS // SOAP Send objects
  TRIGGERED_SENDS // TriggeredSendDefinition metadata
  TRACKING_SENT
  TRACKING_OPEN
  TRACKING_CLICK
  TRACKING_BOUNCE
  TRACKING_UNSUB
  TRACKING_NOTSENT
  JOURNEYS
  AUTOMATIONS
  QUERY_DEFINITIONS
  CONTENT_ASSETS
  CONTENT_CATEGORIES
  AUDIENCE_UPLOAD // independently preserved audience snapshot uploaded by a user
  EMAILS // SOAP Email objects (HTML/text of the emails referenced by send jobs)
  CONTENT_FILES // images / PDFs referenced by archived content, downloaded from their published URLs
}

enum SfDatasetStatus {
  PENDING
  RUNNING
  EXTRACTED // pagination finished; see verificationStatus
  FAILED
  CANCELLED
  NOT_ACCESSIBLE // permission / scope / object not available for this account
  NOT_RETRIEVABLE // outside the source retention window or unsupported by the API
}

enum SfVerificationStatus {
  VERIFIED
  PARTIALLY_VERIFIED
  UNVERIFIED
  FAILED
  NOT_ACCESSIBLE
  NOT_RETRIEVABLE
}

enum SfTrackingEventType {
  SENT
  OPEN
  CLICK
  BOUNCE
  UNSUB
  NOTSENT
}

enum SfReconStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum SfReconClass {
  MATCHED_SENT // in audience and observed in send tracking
  AUDIENCE_NO_SENT_EVENT // in audience, no observed SentEvent (evidence, if any, in flags)
  TRACKING_NOT_IN_AUDIENCE // observed SentEvent, absent from the supplied audience
  DUPLICATE_AUDIENCE_ROW // 2nd+ audience row with the same normalised identity
  INVALID_IDENTIFIER // audience row with missing/invalid identity value
  RETENTION_UNAVAILABLE // send tracking for the job is not retrievable / not extracted
  UNRESOLVED // insufficient evidence to classify
}

model SalesforceConnection {
  id               String             @id @default(cuid())
  name             String
  kind             SfConnectionKind   @default(LIVE)
  status           SfConnectionStatus @default(NOT_CONFIGURED)
  authBaseUri      String?            @map("auth_base_uri")
  restBaseUri      String?            @map("rest_base_uri") // from token response unless overridden
  soapBaseUri      String?            @map("soap_base_uri") // from token response unless overridden
  enterpriseMid    String?            @map("enterprise_mid")
  defaultMid       String?            @map("default_mid")
  secretsEncrypted String?            @map("secrets_encrypted") // AES-256-GCM envelope {clientId, clientSecret}
  secretsHint      Json               @default("{}") @map("secrets_hint")
  grantedScopes    String[]           @default([]) @map("granted_scopes")
  accountInfo      Json               @default("{}") @map("account_info") // /v2/userinfo (non-secret)
  capabilities     Json               @default("{}") // per-object read probe results
  settings         Json               @default("{}") // rate limits, source timezone, retention notes
  lastTestedAt     DateTime?          @map("last_tested_at")
  lastSuccessAt    DateTime?          @map("last_success_at")
  lastErrorAt      DateTime?          @map("last_error_at")
  lastError        String?            @map("last_error")
  createdById      String?            @map("created_by_id")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  archivedAt       DateTime?          @map("archived_at")

  businessUnits SalesforceBusinessUnit[]
  backupJobs    SalesforceBackupJob[]
  schedules     SalesforceBackupSchedule[]

  @@map("salesforce_connections")
}

model SalesforceBusinessUnit {
  id           String               @id @default(cuid())
  connectionId String               @map("connection_id")
  connection   SalesforceConnection @relation(fields: [connectionId], references: [id])
  mid          String // MIDs kept as strings (no numeric coercion)
  name         String
  parentMid    String?              @map("parent_mid")
  customerKey  String?              @map("customer_key")
  isEnterprise Boolean              @default(false) @map("is_enterprise")
  isActive     Boolean?             @map("is_active")
  selected     Boolean              @default(false) // included in backups by default
  source       String // "soap:BusinessUnit" | "userinfo" | "manual"
  raw          Json                 @default("{}")
  discoveredAt DateTime             @default(now()) @map("discovered_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  @@unique([connectionId, mid])
  @@map("salesforce_business_units")
}

model SalesforceBackupJob {
  id                 String               @id @default(cuid())
  code               String               @unique // BKP-yyyyMMdd-xxxxxx
  connectionId       String               @map("connection_id")
  connection         SalesforceConnection @relation(fields: [connectionId], references: [id])
  mids               String[]
  mode               SfBackupMode         @default(FULL)
  scope              Json // selected data types, DE keys, date range
  status             SfBackupJobStatus    @default(QUEUED)
  verificationStatus SfVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationNotes  Json                 @default("[]") @map("verification_notes")
  stats              Json                 @default("{}")
  isSimulated        Boolean              @default(false) @map("is_simulated")
  scheduleId         String?              @map("schedule_id")
  parentJobId        String?              @map("parent_job_id") // retry-of
  createdById        String?              @map("created_by_id")
  createdByEmail     String?              @map("created_by_email")
  cancelRequestedAt  DateTime?            @map("cancel_requested_at")
  leaseUntil         DateTime?            @map("lease_until") // single-runner lease for step jobs
  stepCount          Int                  @default(0) @map("step_count")
  startedAt          DateTime?            @map("started_at")
  finishedAt         DateTime?            @map("finished_at")
  errorMessage       String?              @map("error_message")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  datasets SalesforceBackupDataset[]

  @@index([connectionId, createdAt])
  @@index([status])
  @@map("salesforce_backup_jobs")
}

model SalesforceBackupSchedule {
  id            String               @id @default(cuid())
  connectionId  String               @map("connection_id")
  connection    SalesforceConnection @relation(fields: [connectionId], references: [id])
  name          String
  scope         Json
  mids          String[]
  intervalHours Int                  @map("interval_hours")
  enabled       Boolean              @default(true)
  nextRunAt     DateTime             @map("next_run_at")
  lastRunAt     DateTime?            @map("last_run_at")
  lastJobId     String?              @map("last_job_id")
  createdById   String?              @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  @@index([enabled, nextRunAt])
  @@map("salesforce_backup_schedules")
}

model SalesforceBackupDataset {
  id                  String               @id @default(cuid())
  backupJobId         String?              @map("backup_job_id")
  backupJob           SalesforceBackupJob? @relation(fields: [backupJobId], references: [id])
  connectionId        String               @map("connection_id")
  mid                 String
  kind                SfDatasetKind
  objectType          String               @map("object_type") // SOAP object / REST resource
  sourceKey           String?              @map("source_key") // DE CustomerKey, JobID, …
  label               String
  status              SfDatasetStatus      @default(PENDING)
  verificationStatus  SfVerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationDetails Json                 @default("{}") @map("verification_details")
  params              Json                 @default("{}") // filters, date window, schema snapshot
  checkpoint          Json                 @default("{}") // { requestId, nextPage, restPage }
  attempt             Int                  @default(1)
  pagesFetched        Int                  @default(0) @map("pages_fetched")
  recordsExtracted    Int                  @default(0) @map("records_extracted")
  sourceCount         Int?                 @map("source_count") // independently obtained count
  sourceCountMethod   String?              @map("source_count_method")
  apiCalls            Int                  @default(0) @map("api_calls")
  retries             Int                  @default(0)
  bytesStored         BigInt               @default(0) @map("bytes_stored")
  coverageFrom        DateTime?            @map("coverage_from")
  coverageTo          DateTime?            @map("coverage_to")
  isSimulated         Boolean              @default(false) @map("is_simulated")
  errorMessage        String?              @map("error_message")
  supersededById      String?              @map("superseded_by_id")
  startedAt           DateTime?            @map("started_at")
  finishedAt          DateTime?            @map("finished_at")
  lastProgressAt      DateTime?            @map("last_progress_at")
  sealedAt            DateTime?            @map("sealed_at") // rows immutable after this
  verifiedAt          DateTime?            @map("verified_at")
  createdById         String?              @map("created_by_id")
  createdAt           DateTime             @default(now()) @map("created_at")

  pages SalesforceBackupPage[]

  @@index([backupJobId])
  @@index([connectionId, mid, kind, sourceKey])
  @@index([kind, status])
  @@index([kind, status, supersededById], map: "salesforce_backup_datasets_current_idx")
  @@map("salesforce_backup_datasets")
}

/// One SFMC response page: the raw payload is stored encrypted in the archive store; its hash is kept here.
model SalesforceBackupPage {
  id            String                  @id @default(cuid())
  datasetId     String                  @map("dataset_id")
  dataset       SalesforceBackupDataset @relation(fields: [datasetId], references: [id])
  attempt       Int
  pageNo        Int                     @map("page_no")
  recordCount   Int                     @map("record_count")
  requestId     String?                 @map("request_id")
  overallStatus String?                 @map("overall_status")
  storageKey    String                  @map("storage_key")
  sha256        String // of the raw (unencrypted) payload
  byteSize      Int                     @map("byte_size")
  fetchedAt     DateTime                @default(now()) @map("fetched_at")

  @@unique([datasetId, attempt, pageNo])
  @@map("salesforce_backup_pages")
}

model SalesforceBackupManifest {
  id             String   @id @default(cuid())
  scope          String // DATASET | JOB | EVIDENCE
  backupJobId    String?  @map("backup_job_id")
  datasetId      String?  @map("dataset_id")
  version        Int      @default(1)
  manifest       Json
  sha256         String // of the canonical manifest JSON
  previousSha256 String?  @map("previous_sha256") // hash chain per backup job
  storageKey     String?  @map("storage_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([backupJobId])
  @@index([datasetId])
  @@map("salesforce_backup_manifests")
}

model SalesforceDataExtension {
  id                  String    @id @default(cuid())
  connectionId        String    @map("connection_id")
  mid                 String
  objectId            String?   @map("object_id")
  customerKey         String    @map("customer_key")
  name                String
  description         String?
  categoryId          String?   @map("category_id") // folder
  folderPath          String?   @map("folder_path")
  isSendable          Boolean?  @map("is_sendable")
  isTestable          Boolean?  @map("is_testable")
  sendableField       String?   @map("sendable_field")
  retention           Json      @default("{}")
  createdDate         String?   @map("created_date") // as returned by SFMC
  modifiedDate        String?   @map("modified_date")
  raw                 Json      @default("{}")
  inventoryDatasetId  String?   @map("inventory_dataset_id")
  latestRowsDatasetId String?   @map("latest_rows_dataset_id")
  attestedCount       Int?      @map("attested_count") // count read from the SFMC UI by an operator
  attestedById        String?   @map("attested_by_id")
  attestedByEmail     String?   @map("attested_by_email")
  attestedAt          DateTime? @map("attested_at")
  attestationNote     String?   @map("attestation_note")
  isSimulated         Boolean   @default(false) @map("is_simulated")
  firstSeenAt         DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt          DateTime  @default(now()) @map("last_seen_at")

  fields SalesforceDataExtensionField[]

  @@unique([connectionId, mid, customerKey])
  @@index([mid, customerKey])
  @@index([name])
  @@map("salesforce_data_extensions")
}

model SalesforceDataExtensionField {
  id              String                  @id @default(cuid())
  dataExtensionId String                  @map("data_extension_id")
  dataExtension   SalesforceDataExtension @relation(fields: [dataExtensionId], references: [id])
  name            String
  fieldType       String?                 @map("field_type")
  maxLength       String?                 @map("max_length")
  scale           String?
  isPrimaryKey    Boolean?                @map("is_primary_key")
  isRequired      Boolean?                @map("is_required") // nullable = !isRequired
  ordinal         Int?
  defaultValue    String?                 @map("default_value")
  raw             Json                    @default("{}")

  @@unique([dataExtensionId, name])
  @@map("salesforce_data_extension_fields")
}

model SalesforceDataExtensionRow {
  id              BigInt  @id @default(autoincrement())
  datasetId       String  @map("dataset_id")
  dataExtensionId String? @map("data_extension_id") // null for AUDIENCE_UPLOAD
  pageNo          Int     @map("page_no")
  rowNo           Int     @map("row_no")
  values          Json // { fieldName: "string value as returned" }
  rowHash         String  @map("row_hash")
  primaryKey      String? @map("primary_key") // joined PK values, for lookup

  @@unique([datasetId, pageNo, rowNo])
  @@index([datasetId, primaryKey])
  @@index([datasetId, rowHash])
  @@index([values(ops: JsonbPathOps)], type: Gin, map: "salesforce_data_extension_rows_values_gin")
  @@map("salesforce_data_extension_rows")
}

model SalesforceSubscriber {
  id               BigInt  @id @default(autoincrement())
  datasetId        String  @map("dataset_id")
  connectionId     String  @map("connection_id")
  mid              String
  pageNo           Int     @map("page_no")
  rowNo            Int     @map("row_no")
  subscriberKey    String? @map("subscriber_key")
  subscriberId     String? @map("subscriber_id")
  emailAddress     String? @map("email_address")
  status           String?
  createdDate      String? @map("created_date")
  unsubscribedDate String? @map("unsubscribed_date")
  raw              Json    @default("{}")

  @@unique([datasetId, pageNo, rowNo])
  @@index([subscriberKey])
  @@index([emailAddress])
  @@map("salesforce_subscribers")
}

model SalesforceEmailJob {
  id                 String    @id @default(cuid())
  connectionId       String    @map("connection_id")
  mid                String
  jobId              String    @map("job_id") // Send.ID (= SendID / JobID in tracking)
  emailId            String?   @map("email_id")
  emailName          String?   @map("email_name")
  subject            String?
  fromName           String?   @map("from_name")
  fromAddress        String?   @map("from_address")
  sendClassification String?   @map("send_classification")
  status             String?
  sendDate           DateTime? @map("send_date") // parsed (raw keeps the original string)
  sentDate           DateTime? @map("sent_date")
  createdDate        String?   @map("created_date")
  counters           Json      @default("{}") // NumberTargeted, NumberSent, NumberExcluded, … as returned
  targets            Json      @default("{}") // list / DE identifiers where available
  triggeredSendKey   String?   @map("triggered_send_key")
  raw                Json      @default("{}")
  datasetId          String    @map("dataset_id")
  isSimulated        Boolean   @default(false) @map("is_simulated")
  firstSeenAt        DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at")

  @@unique([connectionId, mid, jobId])
  @@index([mid, jobId])
  @@index([emailId])
  @@index([sentDate])
  @@map("salesforce_email_jobs")
}

model SalesforceTrackingEvent {
  id                    BigInt              @id @default(autoincrement())
  datasetId             String              @map("dataset_id")
  connectionId          String              @map("connection_id")
  mid                   String
  eventType             SfTrackingEventType @map("event_type")
  jobId                 String?             @map("job_id") // SendID
  subscriberKey         String?             @map("subscriber_key")
  subscriberId          String?             @map("subscriber_id")
  eventDate             DateTime?           @map("event_date") // parsed (UTC)
  eventDateRaw          String?             @map("event_date_raw") // exactly as returned
  batchId               String?             @map("batch_id")
  listId                String?             @map("list_id")
  triggeredSendObjectId String?             @map("triggered_send_object_id")
  url                   String?
  urlId                 String?             @map("url_id")
  bounceCategory        String?             @map("bounce_category")
  bounceType            String?             @map("bounce_type")
  smtpCode              String?             @map("smtp_code")
  smtpReason            String?             @map("smtp_reason")
  sourceEventType       String?             @map("source_event_type") // EventType as returned
  raw                   Json                @default("{}")
  fingerprint           String // hash of identifying fields; duplicates are detected, never dropped
  pageNo                Int                 @map("page_no")
  rowNo                 Int                 @map("row_no")

  @@unique([datasetId, pageNo, rowNo])
  @@index([mid, jobId, eventType])
  @@index([subscriberKey])
  @@index([eventDate])
  @@index([datasetId, fingerprint])
  @@index([subscriberKey, datasetId], map: "salesforce_tracking_events_subscriber_dataset_idx")
  @@map("salesforce_tracking_events")
}

/// SOAP Email object: the email definition a send job references (Send.Email.ID). HTML and text
/// bodies are stored unaltered in the archive store; this row keeps metadata and hashes.
model SalesforceEmail {
  id             String    @id @default(cuid())
  connectionId   String    @map("connection_id")
  mid            String
  emailId        String    @map("email_id")
  name           String?
  subject        String?
  preheader      String?
  emailType      String?   @map("email_type")
  createdDate    String?   @map("created_date") // as returned by SFMC
  modifiedDate   String?   @map("modified_date")
  modifiedAt     DateTime? @map("modified_at") // parsed (source offset applied)
  htmlStorageKey String?   @map("html_storage_key")
  htmlSha256     String?   @map("html_sha256")
  htmlBytes      Int?      @map("html_bytes")
  textStorageKey String?   @map("text_storage_key")
  textSha256     String?   @map("text_sha256")
  references     Json      @default("[]")
  raw            Json      @default("{}") // without the bodies (those are in the archive store)
  datasetId      String    @map("dataset_id")
  isSimulated    Boolean   @default(false) @map("is_simulated")
  firstSeenAt    DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime  @default(now()) @map("last_seen_at")

  @@unique([connectionId, mid, emailId])
  @@map("salesforce_emails")
}

/// A file (image, PDF, …) referenced by archived content, downloaded from its public URL so
