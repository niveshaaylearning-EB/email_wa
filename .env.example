# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/niveshaay_cc
# Optional: when unset the in-process queue driver is used (dev/test only).
REDIS_URL=

# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used for AES-256-GCM encryption of OAuth tokens and API keys at rest. Rotating it requires re-entering secrets.
CREDENTIALS_ENCRYPTION_KEY=

# Session cookie lifetime (hours)
SESSION_TTL_HOURS=12

# ─── Send safety (defence in depth) ─────────────────────────────────────
# Master kill-switch. Unless "true", no provider send endpoint is ever called,
# regardless of integration mode or campaign approval. Keep "false" in dev/staging.
ALLOW_LIVE_SEND=false
# Hard ceiling on recipients for a single live campaign (accidental mass-send guard).
LIVE_SEND_MAX_RECIPIENTS=5000

# ─── Zoho (CRM + Marketing Automation share one OAuth client) ───────────
# Register a "Server-based Application" at https://api-console.zoho.com (use the console of your DC).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Zoho API console.
ZOHO_REDIRECT_URI=http://localhost:3000/api/integrations/zoho/callback
# Data center: com | eu | in | com.au | jp | ca | sa | com.cn | uk
ZOHO_DC=in

# ─── DoubleTick ─────────────────────────────────────────────────────────
# Can also be entered (encrypted at rest) from Integrations → DoubleTick.
DOUBLETICK_API_KEY=
DOUBLETICK_SENDER_NUMBER=
# Shared secret configured in the DoubleTick webhook URL / header (see docs/integrations.md)
DOUBLETICK_WEBHOOK_SECRET=

# ─── Salesforce Marketing Cloud archive (read-only) ────────────────────
# Encrypted archive store for raw API payloads, content and evidence packages. Default:
# ~/.niveshaay-cc/archive (outside OneDrive). Use encrypted, backed-up storage in production.
ARCHIVE_STORAGE_DIR=
# Optional dedicated 32-byte base64 key for archive objects (derived from CREDENTIALS_ENCRYPTION_KEY
# when unset). Losing it makes the archive unreadable — escrow it.
ARCHIVE_ENCRYPTION_KEY=
# SIMULATED Salesforce tenant for development/tests (always refused when NODE_ENV=production).
SFMC_ALLOW_SIMULATED=true

# ─── Seed (development only) ────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@niveshaay.local
SEED_ADMIN_PASSWORD=

# ─── TEST MODULE: DoubleTick onboarding bot trigger (remove after testing) ───
# Bot Studio "On Webhook" trigger for bot onboarding_entity_type. Each real call sends a REAL WhatsApp message.
DOUBLETICK_ONBOARDING_WEBHOOK_URL=
# The trigger's own Authorization Key from Bot Studio (preferred over the main API key).
DOUBLETICK_ONBOARDING_AUTH_KEY=
